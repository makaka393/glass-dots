/* сгенерировано matugen */
* {
    glass:              #{{colors.surface_container_lowest.default.hex_stripped}}73;
    selected-bg:        #{{colors.primary.default.hex_stripped}}33;
    glass-border:       #{{colors.on_surface.default.hex_stripped}}1f;
    chip:               #{{colors.on_surface.default.hex_stripped}}14;
    chip-hover:         #{{colors.on_surface.default.hex_stripped}}24;
    fg:                 {{colors.on_surface.default.hex}};
    fg-variant:         {{colors.on_surface_variant.default.hex}};
    primary:            {{colors.primary.default.hex}};
    on-primary:         {{colors.on_primary.default.hex}};
    primary-container:  {{colors.primary_container.default.hex}};
    on-primary-container: {{colors.on_primary_container.default.hex}};
    error:              {{colors.error.default.hex}};
}
